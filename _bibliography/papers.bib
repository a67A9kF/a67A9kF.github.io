@article{Under Submission,
  abbr={Under Submission},
  title={In-Storage Secure Multi-Party Acceleration for Inference Privacy},
  author={Mahapatra, R},
  abstract={Identified that memory and communication overheads in Secure Multi-Party Computation (SMPC) proto-
 cols constrain the scalability of privacy-preserving neural inference. Proposed embedding accelerators
 within storage devices, where each storage unit functions as a computational node, and utilizing the
 system interconnect (PCIe) to facilitate inference processing. This approach enhances both performance
 (3.9× ) and energy efficiency (11.5×)},
  journal={Under Submission},
  year={2025},
  url={http://link.aps.org/doi/10.1103/PhysRev.47.777},
  dimensions={true},
  google_scholar_id={FJp7Oo0AAAAJ}
}

@article{ISCA,
  abbr={ISCA},
  title={In-Storage Acceleration of Retrieval-Augmented Generation},
  author={Mahapatra, R},
  abstract={Deployed and analyzed end-to-end RAGs on Amazon AWS, identifying retrieval as the primary perfor-
mance bottleneck (61% of end-to-end latency). Proposed a shape-shifting polymorphic in-storage
accelerator to support diverse RAG algorithms and dynamic data structures, reducing data movement
overhead and improving throughput (3.6× over Nvidia A100). Shifted the bottleneck from retrieval to
LLM inference, improving overall efficiency for enterprise-scale RAG deployments.},
  journal={ISCA},
  year={2025},
  url={http://link.aps.org/doi/10.1103/PhysRev.47.777},
  dimensions={true},
  google_scholar_id={FJp7Oo0AAAAJ}
}
