}


@article{ISCA 2025,
  abbr={ISCA 2025},
  title={In-Storage Acceleration of Retrieval-Augmented Generation},
  author={Mahapatra, R},
  abstract={Deployed and analyzed end-to-end RAGs on Amazon AWS, identifying retrieval as the primary perfor-
mance bottleneck (61% of end-to-end latency). Proposed a shape-shifting polymorphic in-storage
accelerator to support diverse RAG algorithms and dynamic data structures, reducing data movement
overhead and improving throughput (3.6× over Nvidia A100). Shifted the bottleneck from retrieval to
LLM inference, improving overall efficiency for enterprise-scale RAG deployments.},
  journal={ISCA},
  year={2025},
  publisher=ISCA,
  html={https://journals.aps.org/pr/abstract/10.1103/PhysRev.47.777},
  dimensions={true},
  google_scholar_id={FJp7Oo0AAAAJ},
  selected={true},
  inspirehep_id = {3255}
}

@article{ASPLOS 2024,
  abbr={ASPLOS 2024},
  title={Domain-Specific Computational Storage for Serverless Computing},
  author={Mahapatra, R},
  abstract={Serverless applications suffer from data access latency due to disaggregated storage. Proposed em-
bedding computation within storage to execute functions directly, minimizing data transfer overhead.
I performed an extensive design space analysis of over 650 accelerator configurations to identify the
optimal design that adheres to power and thermal constraints of storage. Evaluations demonstrate our
approach outperforms high-end GPUs (2.7× over Nvidia RTX 2080Ti) accessing disaggregated storage.},
  journal={ASPLOS},
  year={2024},
  publisher=ASPLOS,
  pages={530--548},
  doi={10.1145/3620665.3640413}
  html={https://dl.acm.org/doi/abs/10.1145/3620665.3640413},
  dimensions={true},
  google_scholar_id={FJp7Oo0AAAAJ},
  selected={true},
  inspirehep_id = {3255}
}

@article{ASPLOS 2024,
  abbr={ASPLOS 2024},
  title={Tandem Processor: Grappling with Emerging Operators in Neural Networks},
  author={Mahapatra, R},
  abstract={Language models (LLMs) increasingly incorporate non-GEMM layers intertwined with GEMM operations,
creating bottlenecks in GPUs and accelerators that rely on dedicated units for non-GEMM tasks. The Tan-
dem Processor addresses this challenge. My contributions to this project included generating baseline
results, evaluating performance with Nvidia GPU TensorRT, and implementing the Tandem simulator.},
  journal={ASPLOS},
  year={2024},
  publisher=ACM,
  pages={1165--1182},
  doi={10.1145/3620665.3640365}
  html={https://dl.acm.org/doi/abs/10.1145/3620665.3640365},
  dimensions={true},
